PORT=3001
# Convex persistence. CONVEX_URL is written to .env.local by `npx convex dev`.
# Set the same secret on the deployment: npx convex env set CONVEX_SERVER_SECRET <value>
CONVEX_URL=
CONVEX_SERVER_SECRET=
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3001

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_SECRET=

# Client build-time: public URL of the API server when it is hosted separately
# (e.g. https://fableboard-production.up.railway.app). Leave empty for local dev.
VITE_SERVER_URL=
