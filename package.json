{
  "name": "fableboard",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @fableboard/client --filter @fableboard/server dev",
    "dev:client": "pnpm --filter @fableboard/client dev",
    "dev:server": "pnpm --filter @fableboard/server dev",
    "build": "pnpm --filter @fableboard/shared build && pnpm --parallel --filter @fableboard/client --filter @fableboard/server build",
    "build:shared": "pnpm --filter @fableboard/shared build",
    "test": "pnpm build:shared && pnpm -r --if-present test",
    "test:e2e": "node --import tsx --test --test-concurrency=1 e2e/flows.test.ts",
    "demo": "node --import tsx e2e/demo.ts",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "dependencies": {
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "tsx": "^4.19.2"
  }
}
